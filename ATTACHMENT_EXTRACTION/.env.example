# Example environment variables file
# Copy this file to .env and fill in your actual values

# ============ CREDENTIALS ============ 

# Personal email credentials
EMAIL_ADDRESS=your-email@outlook.com
OUTLOOK_PASSWORD=your-regular-password
OUTLOOK_APP_PASSWORD=your-16-char-app-password

# Azure app credentials (for OAuth2 authentication)
CLIENT_ID=your-azure-app-client-id
TENANT_ID=your-tenant-id-or-common
CLIENT_SECRET=your-client-secret-if-needed

# Work email credentials (if applicable)
WORK_EMAIL_ADDRESS=your-work-email@company.com
WORK_PASSWORD=your-work-password-or-app-password
WORK_APP_PASSWORD=your-work-app-password

WORK_CLIENT_ID=your-work-client-id
WORK_TENANT_ID=your-work-tenant-id
WORK_CLIENT_SECRET=your-work-client-secret

# Gmail credentials (alternative email provider)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password


# ========== CONFIGURATION VARIABLES ============

# Exchange server configuration
EXCHANGE_SERVER=outlook.office365.com
EXCHANGE_VERSION=Exchange2016

# Folder configuration
SENT_ITEMS_FOLDER=Sent Items

# Output directory for downloaded attachments
OUTPUT_DIR=/path/to/your/attachments/folder